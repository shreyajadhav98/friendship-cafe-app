# Copy to .env and replace with the café entrance coordinates when available.
VITE_CAFE_NAME=New Friendship Cafe
VITE_CAFE_LAT=16.7050
VITE_CAFE_LNG=74.2433
# Optional URL embedded in locally generated QR codes. For Wi-Fi testing, use http://<computer-LAN-IP>:5173.
# Production should use the public HTTPS website URL. When unset, server/scripts/generate-table-qrs.js auto-detects a LAN IP in development.
VITE_APP_URL=
# Leave blank to use the same-origin Vite proxy so phones on Wi-Fi can reach API and Socket.io through the LAN URL.
VITE_API_URL=
